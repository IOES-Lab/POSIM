<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="wamv" xmlns:gz="http://gazebosim.org">
    <include merge="true">
      <uri>model://wam-v</uri>
    </include>
    <link name="gnss_link">
      <pose relative_to="base_link">0 0 1.8 0 0 0</pose>
      <inertial>
        <mass>.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="gnss" type="custom" gz:type="posim_gnss">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>/model/wamv/gnss</topic>
      </sensor>
    </link>
    <joint name="gnss_joint" type="fixed">
      <parent>base_link</parent>
      <child>gnss_link</child>
    </joint>
    <plugin name="posim::Gnss" filename="libposim_gnss.so">
      <update_rate>5</update_rate>
      <latency>0.2</latency>
      <reacquire_seconds>3</reacquire_seconds>
      <dry_margin>0.05</dry_margin>
      <horizontal_stddev>0.7</horizontal_stddev>
      <vertical_stddev>1.2</vertical_stddev>
      <velocity_stddev>0.1</velocity_stddev>
      <water_level>0</water_level>
      <seed>42</seed>
      <enabled>true</enabled>
      <link_name>gnss_link</link_name>
      <topic>/model/wamv/gnss</topic>
      <wave_topic />
    </plugin>
  </model>
</sdf>
