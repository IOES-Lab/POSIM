<sdf version="1.10">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="multibeam_sonar_system" name="custom::MultibeamSonarSystem" />
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.1 0.1 0.1 1</background>
      <shadows>false</shadows>
    </scene>
    <model name="target_gray">
      <static>true</static>
      <pose>4.01 0 2 0 0 0</pose>
      <link name="target">
        <visual name="panel">
          <geometry>
            <box>
              <size>0.02 30 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="panel">
          <geometry>
            <box>
              <size>0.02 30 10</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
