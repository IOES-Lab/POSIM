From 2b788a04e69e0aaaef78b9175f816dfcc565b5a0 Mon Sep 17 00:00:00 2001
From: Vladimir Ermakov <vooon341@gmail.com>
Date: Wed, 21 Oct 2026 16:54:02 +0200
Subject: [PATCH] mavros: keep the Router back-reference a plain pointer

Breaking the Router <-> Endpoint cycle is right, but a weak_ptr puts a
weak_ptr::lock() (CAS loop on the Router control block) plus a shared_ptr
release (atomic decrement) into Endpoint::recv_message() and
ROSEndpoint::send_message(), i.e. on every packet of every link. That
control block is one cache line shared by all endpoint threads, so the
FCU, GCS and UAS links would all contend on it per message. The router
hot path is deliberately kept free of locks and atomics on shared state.

Use a non-owning Router * instead. Lifetime is already bounded on the
endpoint side:

- MAVConn callbacks run on the Router's shared io_context, which ~Router
  stops and joins (shutdown_owned()) before any member is destroyed.
- ROSEndpoint already binds a raw `this` into its subscription.

~Router now closes every endpoint and clears its parent after the io
thread is joined, so an endpoint that is still held elsewhere sees
parent == nullptr and open() keeps returning "parent not set". The
regression tests from the previous commit pass unchanged, and the test
fixtures no longer need to break the cycle by hand.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 mavros/include/mavros/mavros_router.hpp      | 26 +++++++++++++++-----
 mavros/src/lib/mavros_router.cpp             | 17 ++++++-------
 mavros/test/test_router.cpp                  | 18 +++++---------
 mavros/test/test_router_e2e.cpp              |  8 +-----
 mavros/test/test_router_select_benchmark.cpp |  2 +-
 5 files changed, 35 insertions(+), 36 deletions(-)

diff --git a/mavros/include/mavros/mavros_router.hpp b/mavros/include/mavros/mavros_router.hpp
index 4eb688e5b..7ab20808b 100644
--- a/mavros/include/mavros/mavros_router.hpp
+++ b/mavros/include/mavros/mavros_router.hpp
@@ -81,7 +81,7 @@ class Endpoint : public std::enable_shared_from_this<Endpoint>
   };
 
   Endpoint()
-  : parent(),
+  : parent(nullptr),
     id(0),
     link_type(Type::fcu),
     url{},
@@ -94,8 +94,13 @@ class Endpoint : public std::enable_shared_from_this<Endpoint>
     remote_addrs.emplace(broadcast_addr);
   }
 
-  // Endpoints are owned by Router; the back-reference must not retain it.
-  std::weak_ptr<Router> parent;
+  // Non-owning back-reference. Endpoints are owned by Router, which detaches
+  // them (close() + parent = nullptr) in its destructor after the shared io
+  // thread has been joined, so no endpoint callback can observe a dangling
+  // pointer. A plain pointer keeps the per-message path free of atomics: a
+  // weak_ptr::lock() here would hit the Router control block from every link
+  // thread on every packet.
+  Router * parent;
 
   uint32_t id;                           // id of the endpoint
   Type link_type;                        // class of the endpoint
@@ -218,9 +223,8 @@ class Router : public rclcpp::Node
 
     router_io_runner.start([this]() {this->router_io_runner.io().run();});
 
-    // Delay parameter callback initialization because
-    // add/del endpoints calls have to use shared_from_this(),
-    // which cannot be used before we leave the constructor.
+    // Delay parameter callback initialization so that endpoints are not
+    // created before we leave the constructor.
     startup_delay_timer = this->create_wall_timer(
       10ms, [this]() {
         this->startup_delay_timer->cancel();
@@ -234,6 +238,16 @@ class Router : public rclcpp::Node
     reconnect_timer->cancel();
     stale_addrs_timer->cancel();
     router_io_runner.shutdown_owned();
+
+    // The io thread is joined, so no link callback can run any more. Detach
+    // the endpoints: an endpoint that is still held elsewhere must not keep a
+    // pointer to this Router.
+    for (auto & kv : endpoints) {
+      kv.second->close();
+      kv.second->parent = nullptr;
+    }
+    endpoints.clear();
+    remote_index.clear();
   }
 
   void route_message(Endpoint::SharedPtr src, const mavlink_message_t * msg, const Framing framing);
diff --git a/mavros/src/lib/mavros_router.cpp b/mavros/src/lib/mavros_router.cpp
index 873d3aa63..865c63643 100644
--- a/mavros/src/lib/mavros_router.cpp
+++ b/mavros/src/lib/mavros_router.cpp
@@ -188,10 +188,7 @@ void Router::add_endpoint(
     ep = std::make_shared<MAVConnEndpoint>();
   }
 
-  // NOTE(vooon): has type std::shared_ptr<rclcpp::Node>
-  auto shared_this = shared_from_this();
-
-  ep->parent = std::static_pointer_cast<Router>(shared_this);
+  ep->parent = this;
   ep->set_id(id);
   ep->link_type = static_cast<Endpoint::Type>(request->type);
   ep->url = request->url;
@@ -464,7 +461,7 @@ void Endpoint::recv_message(const mavlink_message_t * msg, const Framing framing
     this->stale_addrs.erase(sysid_compid_addr);
   }
 
-  auto nh = this->parent.lock();
+  auto * nh = this->parent;
   if (!nh) {
     return;
   }
@@ -497,7 +494,7 @@ bool MAVConnEndpoint::is_open()
 
 std::pair<bool, std::string> MAVConnEndpoint::open()
 {
-  auto nh = this->parent.lock();
+  auto * nh = this->parent;
   if (!nh) {
     return {false, "parent not set"};
   }
@@ -602,7 +599,7 @@ bool ROSEndpoint::is_open()
 
 std::pair<bool, std::string> ROSEndpoint::open()
 {
-  auto nh = this->parent.lock();
+  auto * nh = this->parent;
   if (!nh) {
     return {false, "parent not set"};
   }
@@ -647,7 +644,7 @@ void ROSEndpoint::send_message(
     return;
   }
 
-  auto nh = this->parent.lock();
+  auto * nh = this->parent;
   if (!nh) {
     return;
   }
@@ -656,7 +653,7 @@ void ROSEndpoint::send_message(
 
   if (ok) {
     this->source->publish(std::move(rmsg));
-  } else if (auto nh = this->parent.lock()) {
+  } else {
     RCLCPP_ERROR(nh->get_logger(), "message conversion error");
   }
 }
@@ -672,7 +669,7 @@ void ROSEndpoint::ros_recv_message(mavros_msgs::msg::Mavlink::UniquePtr rmsg)
 
   if (ok) {
     recv_message(&mmsg, framing);
-  } else if (auto nh = this->parent.lock()) {
+  } else if (auto * nh = this->parent) {
     RCLCPP_ERROR(nh->get_logger(), "message conversion error");
   }
 }
diff --git a/mavros/test/test_router.cpp b/mavros/test/test_router.cpp
index e33a53c22..894ab7995 100644
--- a/mavros/test/test_router.cpp
+++ b/mavros/test/test_router.cpp
@@ -114,14 +114,8 @@ class TestRouter : public ::testing::Test
 
   ~TestRouter()
   {
-    // Break the Endpoint <-> Router reference cycle (router->endpoints and
-    // router->remote_index hold endpoints, and each endpoint->parent holds the
-    // router), otherwise the Router node (a DDS participant) is leaked. Leaked
-    // participants from concurrent test processes crash FastDDS discovery.
-    for (auto & router : routers_) {
-      router->endpoints.clear();
-      router->remote_index.clear();
-    }
+    // Release the Router nodes (DDS participants) before rclcpp::shutdown().
+    // Leaked participants from concurrent test processes crash FastDDS discovery.
     routers_.clear();
 
     // NOTE(vooon): required to remove any remaining Nodes
@@ -132,7 +126,7 @@ class TestRouter : public ::testing::Test
   void attach_lifetime_endpoint(Router::SharedPtr router, Endpoint::SharedPtr ep)
   {
     router->startup_delay_timer->cancel();
-    ep->parent = router;
+    ep->parent = router.get();
     router->endpoints[1] = ep;
     router->remote_index[0] = {ep};
   }
@@ -154,7 +148,7 @@ class TestRouter : public ::testing::Test
       std::set<addr_t> remotes) {
         auto ep = std::make_shared<MockEndpoint>();
 
-        ep->parent = router;
+        ep->parent = router.get();
         ep->id = id;
         ep->link_type = type;
         ep->url = url;
@@ -549,7 +543,7 @@ TEST_F(TestRouter, route_drops_when_only_same_link_type_exists)
 
   auto make_ep = [router](id_t id, const std::string & url) {
       auto ep = std::make_shared<MockEndpoint>();
-      ep->parent = router;
+      ep->parent = router.get();
       ep->id = id;
       ep->link_type = LT::fcu;
       ep->url = url;
@@ -657,7 +651,7 @@ TEST_F(TestRouter, route_stress_multithreaded_broadcast)
 
   auto make_ep = [router](id_t id, LT type) {
       auto ep = std::make_shared<StressEndpoint>();
-      ep->parent = router;
+      ep->parent = router.get();
       ep->id = id;
       ep->link_type = type;
       ep->remote_addrs = {0x0000};
diff --git a/mavros/test/test_router_e2e.cpp b/mavros/test/test_router_e2e.cpp
index ee26aa7cb..4929feaa1 100644
--- a/mavros/test/test_router_e2e.cpp
+++ b/mavros/test/test_router_e2e.cpp
@@ -106,13 +106,7 @@ class E2ERouter : public ::testing::Test
   {
     // Stop the executor first so nothing can run during teardown.
     stop_spinner();
-    // Break the Endpoint <-> Router reference cycle (router->endpoints and
-    // router->remote_index hold endpoints, and each endpoint->parent holds the
-    // router), otherwise the Router node (a DDS participant) is leaked.
-    for (auto & router : routers_) {
-      router->endpoints.clear();
-      router->remote_index.clear();
-    }
+    // Release the Router nodes (DDS participants) before rclcpp::shutdown().
     routers_.clear();
   }
 
diff --git a/mavros/test/test_router_select_benchmark.cpp b/mavros/test/test_router_select_benchmark.cpp
index 26be3f58d..5cf0c0af2 100644
--- a/mavros/test/test_router_select_benchmark.cpp
+++ b/mavros/test/test_router_select_benchmark.cpp
@@ -81,7 +81,7 @@ class RouterSelectBenchmark : public benchmark::Fixture
 
     auto make_ep = [this](id_t id, Endpoint::Type type, addr_t addr) {
         auto ep = std::make_shared<SelectEndpoint>();
-        ep->parent = router_;
+        ep->parent = router_.get();
         ep->id = id;
         ep->link_type = type;
         ep->remote_addrs = {0x0000, addr};
