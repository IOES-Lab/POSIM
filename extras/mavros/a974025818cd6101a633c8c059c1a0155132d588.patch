From a974025818cd6101a633c8c059c1a0155132d588 Mon Sep 17 00:00:00 2001
From: yeseorizi <172019512+yeseorizi@users.noreply.github.com>
Date: Fri, 9 Oct 2026 13:56:26 +0900
Subject: [PATCH] mavros: break Router endpoint ownership cycle

---
 mavros/include/mavros/mavros_router.hpp |  3 +-
 mavros/src/lib/mavros_router.cpp        | 19 +++++---
 mavros/test/test_router.cpp             | 62 +++++++++++++++++++++++++
 3 files changed, 77 insertions(+), 7 deletions(-)

diff --git a/mavros/include/mavros/mavros_router.hpp b/mavros/include/mavros/mavros_router.hpp
index 0dc19c51c..4eb688e5b 100644
--- a/mavros/include/mavros/mavros_router.hpp
+++ b/mavros/include/mavros/mavros_router.hpp
@@ -94,7 +94,8 @@ class Endpoint : public std::enable_shared_from_this<Endpoint>
     remote_addrs.emplace(broadcast_addr);
   }
 
-  std::shared_ptr<Router> parent;
+  // Endpoints are owned by Router; the back-reference must not retain it.
+  std::weak_ptr<Router> parent;
 
   uint32_t id;                           // id of the endpoint
   Type link_type;                        // class of the endpoint
diff --git a/mavros/src/lib/mavros_router.cpp b/mavros/src/lib/mavros_router.cpp
index 34426f43d..873d3aa63 100644
--- a/mavros/src/lib/mavros_router.cpp
+++ b/mavros/src/lib/mavros_router.cpp
@@ -464,7 +464,10 @@ void Endpoint::recv_message(const mavlink_message_t * msg, const Framing framing
     this->stale_addrs.erase(sysid_compid_addr);
   }
 
-  auto & nh = this->parent;
+  auto nh = this->parent.lock();
+  if (!nh) {
+    return;
+  }
   if (new_sysid_addr || new_sysid_compid_addr) {
     // A new remote was learned: flag the router's reverse index so the next
     // routed message rebuilds. A relaxed store is enough -- the flag is just a
@@ -494,7 +497,7 @@ bool MAVConnEndpoint::is_open()
 
 std::pair<bool, std::string> MAVConnEndpoint::open()
 {
-  auto nh = this->parent;
+  auto nh = this->parent.lock();
   if (!nh) {
     return {false, "parent not set"};
   }
@@ -599,7 +602,7 @@ bool ROSEndpoint::is_open()
 
 std::pair<bool, std::string> ROSEndpoint::open()
 {
-  auto & nh = this->parent;
+  auto nh = this->parent.lock();
   if (!nh) {
     return {false, "parent not set"};
   }
@@ -644,12 +647,16 @@ void ROSEndpoint::send_message(
     return;
   }
 
-  rmsg->header.stamp = this->parent->now();
+  auto nh = this->parent.lock();
+  if (!nh) {
+    return;
+  }
+  rmsg->header.stamp = nh->now();
   rmsg->header.frame_id = from_frame_id;
 
   if (ok) {
     this->source->publish(std::move(rmsg));
-  } else if (auto & nh = this->parent) {
+  } else if (auto nh = this->parent.lock()) {
     RCLCPP_ERROR(nh->get_logger(), "message conversion error");
   }
 }
@@ -665,7 +672,7 @@ void ROSEndpoint::ros_recv_message(mavros_msgs::msg::Mavlink::UniquePtr rmsg)
 
   if (ok) {
     recv_message(&mmsg, framing);
-  } else if (auto & nh = this->parent) {
+  } else if (auto nh = this->parent.lock()) {
     RCLCPP_ERROR(nh->get_logger(), "message conversion error");
   }
 }
diff --git a/mavros/test/test_router.cpp b/mavros/test/test_router.cpp
index 86ffa60bd..e33a53c22 100644
--- a/mavros/test/test_router.cpp
+++ b/mavros/test/test_router.cpp
@@ -129,6 +129,20 @@ class TestRouter : public ::testing::Test
     rclcpp::shutdown();
   }
 
+  void attach_lifetime_endpoint(Router::SharedPtr router, Endpoint::SharedPtr ep)
+  {
+    router->startup_delay_timer->cancel();
+    ep->parent = router;
+    router->endpoints[1] = ep;
+    router->remote_index[0] = {ep};
+  }
+
+  void clear_lifetime_endpoints(Router::SharedPtr router)
+  {
+    router->endpoints.clear();
+    router->remote_index.clear();
+  }
+
   Router::SharedPtr create_node()
   {
     auto router = std::make_shared<Router>("test_mavros_router");
@@ -247,6 +261,54 @@ class TestRouter : public ::testing::Test
   }
 };
 
+TEST_F(TestRouter, endpoint_back_reference_does_not_retain_router)
+{
+  auto router = std::make_shared<Router>("router_lifetime_test");
+  auto endpoint = std::make_shared<StressEndpoint>();
+  attach_lifetime_endpoint(router, endpoint);
+  std::weak_ptr<Router> observer = router;
+  router.reset();
+  EXPECT_TRUE(observer.expired());
+  // Clean up the baseline's cycle if the regression assertion fails.
+  if (auto retained = observer.lock()) {
+    clear_lifetime_endpoints(retained);
+  }
+}
+
+TEST_F(TestRouter, ros_endpoint_rejects_open_after_router_destruction)
+{
+  auto router = std::make_shared<Router>("ros_endpoint_lifetime_test");
+  auto endpoint = std::make_shared<ROSEndpoint>();
+  attach_lifetime_endpoint(router, endpoint);
+  std::weak_ptr<Router> observer = router;
+  router.reset();
+  EXPECT_TRUE(observer.expired());
+  if (auto retained = observer.lock()) {
+    clear_lifetime_endpoints(retained);
+    return;
+  }
+  auto result = endpoint->open();
+  EXPECT_FALSE(result.first);
+  EXPECT_EQ(result.second, "parent not set");
+}
+
+TEST_F(TestRouter, mavconn_endpoint_rejects_open_after_router_destruction)
+{
+  auto router = std::make_shared<Router>("mavconn_endpoint_lifetime_test");
+  auto endpoint = std::make_shared<MAVConnEndpoint>();
+  attach_lifetime_endpoint(router, endpoint);
+  std::weak_ptr<Router> observer = router;
+  router.reset();
+  EXPECT_TRUE(observer.expired());
+  if (auto retained = observer.lock()) {
+    clear_lifetime_endpoints(retained);
+    return;
+  }
+  auto result = endpoint->open();
+  EXPECT_FALSE(result.first);
+  EXPECT_EQ(result.second, "parent not set");
+}
+
 TEST_F(TestRouter, set_parameter)
 {
   auto router = this->create_node_no_endpoints();
